<?xml version="1.0" encoding="utf-8"?>
<!-- أندرويد 12+: لا نسخ احتياطي سحابي لبيانات التطبيق (البيانات تنتقل عبر المزامنة أو ملف النسخة الاحتياطية فقط) -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
